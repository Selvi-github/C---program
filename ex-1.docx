using System;

// sum of each row of a jagged array 

class Program
{
    static void Main()
    {
        int[][] arr =
{
    new int[] { 1, 2, 3 },
    new int[] { 4, 5 },
    new int[] { 6, 7, 8, 9 }
};

for (int i = 0; i < arr.Length; i++)
{
    int sum = 0;

    for (int j = 0; j < arr[i].Length; j++)
    {
        sum += arr[i][j];
    }

    Console.WriteLine($"Sum of row {i + 1}: {sum}");
}

    }
}
